---
import Copyable from "./Copyable.astro";
import Icon from "./Icon.astro";
import { siteLinks, version } from "../lib/site";
import type { Copy } from "../i18n/en";

interface Props {
  copy: Copy["install"];
}

const { copy } = Astro.props;
---

<section class="install section--paper" id="install">
  <div class="container">
    <div class="section-head">
      <div data-reveal>
        <p class="kicker">{copy.kicker}</p>
        <h2>{copy.title}</h2>
      </div>
      <p class="lead" data-reveal style="--reveal-delay: 80ms">
        {copy.lead}
      </p>
    </div>

    <div class="install__grid">
      <div class="install__command-card" data-reveal>
        <div class="install__command-head">
          <p>{copy.primaryLabel}</p>
          <span>v{version}</span>
        </div>

        <div class="install__copy">
          <Copyable
            value={copy.command}
            label={copy.copy}
            copied={copy.copied}
            failed={copy.copyFailed}
            showLabel
          />
        </div>

        <div class="install__alts">
          <p class="install__alts-label">{copy.altLabel}</p>
          {
            copy.alts.map((alt) => (
              <div class="install__alt">
                <span>{alt.label}</span>
                <code>{alt.command}</code>
              </div>
            ))
          }
        </div>

        <p class="install__note">{copy.note}</p>
      </div>

      <ol class="install__steps">
        {
          copy.steps.map((step, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="install__step-number">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="install__actions" data-reveal>
      <a
        class="button button--dark"
        href={siteLinks.wiki}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.docs}
        <Icon name="arrow-up-right" />
      </a>
      <a
        class="button button--outline-dark"
        href={siteLinks.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.github}
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .install {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 9vw, 8.5rem);
  }

  .install__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .install__command-card {
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        ellipse 90% 80% at 100% 0%,
        rgba(217, 244, 122, 0.08),
        transparent 70%
      ),
      var(--ink-2);
    color: var(--paper);
    box-shadow: 0 24px 60px rgba(18, 35, 26, 0.16);
  }

  .install__command-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .install__command-head p {
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .install__command-head span {
    color: #72877a;
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .install__copy :global(.copyable) {
    padding: 0.8rem 0.8rem 0.8rem 1rem;
    border-color: rgba(243, 240, 230, 0.12);
    background: rgba(7, 16, 12, 0.7);
  }

  .install__copy :global(.copyable pre) {
    font-size: clamp(0.64rem, 1.1vw, 0.72rem);
  }

  .install__copy :global(.copyable pre)::before {
    color: var(--lime);
    content: "$ ";
  }

  .install__alts {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .install__alts-label {
    margin-bottom: 0.25rem;
    color: #72877a;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .install__alt {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
  }

  .install__alt span {
    color: var(--moss);
    font-size: 0.75rem;
  }

  .install__alt code {
    color: #d3e0d4;
    font-size: 0.64rem;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .install__note {
    margin-top: 1.4rem;
    color: #819589;
    font-family: var(--font-mono);
    font-size: 0.59rem;
    line-height: 1.65;
  }

  .install__steps {
    border-top: 1px solid var(--line-paper-strong);
  }

  .install__steps li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.5rem 0.2rem;
    border-bottom: 1px solid var(--line-paper);
  }

  .install__step-number {
    padding-top: 0.18rem;
    color: var(--forest);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .install__steps h3 {
    color: var(--paper-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .install__steps p {
    max-width: 32rem;
    margin-top: 0.35rem;
    color: var(--muted-paper);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .install__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-paper-strong);
  }

  @media (max-width: 850px) {
    .install__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .install__alt {
      display: grid;
      gap: 0.15rem;
    }

    .install__alt code {
      text-align: left;
    }
  }
</style>
