---
import Copyable from "./Copyable.astro";
import Icon from "./Icon.astro";
import { siteLinks } from "../lib/site";
import type { Copy } from "../i18n/en";

interface Props {
  copy: Copy["agents"];
}

const { copy } = Astro.props;
---

<section class="agents section--dark" id="agents">
  <div class="container">
    <div class="section-head">
      <div data-reveal>
        <p class="kicker">{copy.kicker}</p>
        <h2>{copy.title}</h2>
      </div>
      <p class="lead" data-reveal style="--reveal-delay: 80ms">
        {copy.lead}
      </p>
    </div>

    <div class="agents__grid">
      <ol class="feature-list">
        {
          copy.features.map((feature, index) => (
            <li
              class="feature"
              data-reveal
              style={`--reveal-delay: ${index * 60}ms`}
            >
              <span class="feature__number">{feature.number}</span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="report-wrap" data-reveal style="--reveal-delay: 120ms">
        <div class="report">
          <div class="report__bar">
            <span class="report__label">{copy.report.label}</span>
            <span class="report__status">
              <span class="report__status-dot" aria-hidden="true"></span>
              FAIL
            </span>
          </div>

          <div class="report__body">
            <p class="report__verdict">{copy.report.verdict}</p>

            <div class="report__meta">
              <span>{copy.report.targetLabel}</span>
              <strong>{copy.report.target}</strong>
            </div>

            <p class="report__gate">{copy.report.gate}</p>

            <dl class="report__details">
              <div>
                <dt>{copy.report.summaryLabel}</dt>
                <dd>{copy.report.summary}</dd>
              </div>
              <div>
                <dt>{copy.report.contractLabel}</dt>
                <dd>{copy.report.contract}</dd>
              </div>
              <div>
                <dt>{copy.report.evidenceLabel}</dt>
                <dd>{copy.report.evidence}</dd>
              </div>
            </dl>

            <div class="report__fix">
              <span>{copy.report.fixLabel}</span>
              <p>{copy.report.fix}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mcp" data-reveal>
      <div class="mcp__intro">
        <p class="kicker">{copy.mcp.kicker}</p>
        <h3>{copy.mcp.title}</h3>
        <p class="mcp__body">{copy.mcp.body}</p>

        <ul class="mcp__tools">
          {
            copy.mcp.tools.map((tool) => (
              <li>
                <code>{tool.name}</code>
                <span>{tool.body}</span>
              </li>
            ))
          }
        </ul>

        <a
          class="text-link"
          href={siteLinks.wiki}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.mcp.docs}
          <Icon name="arrow-up-right" />
        </a>
      </div>

      <div class="mcp__code">
        <p class="mcp__code-label">
          {copy.mcp.configLabel}
          <span>JSON</span>
        </p>
        <Copyable
          value={copy.mcp.config}
          label={copy.mcp.copy}
          copied={copy.mcp.copied}
          failed={copy.mcp.copyFailed}
          showLabel
        />
      </div>
    </div>
  </div>
</section>

<style>
  .agents {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 9vw, 8.5rem);
  }

  .agents__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .feature-list {
    border-top: 1px solid var(--line-strong);
  }

  .feature {
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.6rem 0.3rem;
    border-bottom: 1px solid var(--line);
  }

  .feature__number {
    padding-top: 0.15rem;
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.08em;
  }

  .feature h3 {
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .feature p {
    max-width: 38rem;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.68;
  }

  .report-wrap {
    position: sticky;
    top: 6.5rem;
  }

  .report {
    overflow: hidden;
    border: 1px solid rgba(255, 157, 134, 0.24);
    border-radius: var(--radius-md);
    background:
      radial-gradient(
        ellipse 80% 50% at 100% 0%,
        rgba(255, 157, 134, 0.07),
        transparent 65%
      ),
      var(--ink);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
  }

  .report__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 1rem;
    border-bottom: 1px solid var(--line);
    background: rgba(243, 240, 230, 0.025);
  }

  .report__label {
    color: var(--moss);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .report__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fail);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.08em;
  }

  .report__status-dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 3px rgba(255, 157, 134, 0.1);
  }

  .report__body {
    padding: 1.1rem;
  }

  .report__verdict {
    color: var(--fail);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.6vw, 1.12rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .report__meta {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-top: 0.8rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .report__meta span {
    color: var(--moss);
  }

  .report__meta strong {
    color: #d5e2d7;
    font-weight: 450;
  }

  .report__gate {
    margin-top: 0.9rem;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .report__details {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .report__details div {
    display: grid;
    grid-template-columns: 4.7rem minmax(0, 1fr);
    gap: 0.7rem;
  }

  .report__details dt,
  .report__fix span {
    color: var(--moss);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
  }

  .report__details dd {
    color: #aebfb2;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .report__fix {
    margin-top: 1rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid rgba(217, 244, 122, 0.16);
    border-radius: 9px;
    background: rgba(217, 244, 122, 0.035);
  }

  .report__fix p {
    margin-top: 0.35rem;
    color: #dbe7da;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .mcp {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    margin-top: clamp(4.5rem, 9vw, 8rem);
    padding: clamp(1.5rem, 4vw, 2.8rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        ellipse 70% 80% at 100% 0%,
        rgba(217, 244, 122, 0.055),
        transparent 70%
      ),
      rgba(243, 240, 230, 0.02);
  }

  .mcp h3 {
    max-width: 14ch;
    margin-top: 1rem;
    color: var(--paper);
    font-size: clamp(2rem, 3.2vw, 3rem);
  }

  .mcp__body {
    max-width: 41rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .mcp__tools {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.4rem;
  }

  .mcp__tools li {
    display: grid;
    grid-template-columns: 8.8rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
  }

  .mcp__tools code {
    color: var(--lime);
    font-size: 0.68rem;
  }

  .mcp__tools span {
    color: var(--moss);
    font-size: 0.77rem;
    line-height: 1.55;
  }

  .mcp__intro .text-link {
    margin-top: 1.5rem;
  }

  .mcp__code {
    min-width: 0;
  }

  .mcp__code-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
    color: var(--moss);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mcp__code-label span {
    color: #6e8275;
  }

  .mcp__code :global(.copyable) {
    padding: 0.9rem 0.9rem 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: rgba(7, 16, 12, 0.72);
  }

  .mcp__code :global(.copyable pre) {
    font-size: 0.7rem;
  }

  @media (max-width: 980px) {
    .agents__grid {
      grid-template-columns: 1fr;
    }

    .report-wrap {
      position: static;
      max-width: 38rem;
    }

    .mcp {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .mcp__tools li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .report__details div {
      grid-template-columns: 4rem minmax(0, 1fr);
    }
  }
</style>
