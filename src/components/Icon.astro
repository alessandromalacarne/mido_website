---
type IconName =
  | "arrow"
  | "arrow-up"
  | "arrow-up-right"
  | "check"
  | "close"
  | "copy"
  | "github"
  | "menu";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const classes = ["icon", className].filter(Boolean).join(" ");
---

<svg
  class={classes}
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow" && (
    <path
      d="M3 10h13m-5-5 5 5-5 5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
  {name === "arrow-up" && (
    <path
      d="M10 17V3m-5 5 5-5 5 5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
  {name === "arrow-up-right" && (
    <path
      d="M5 15 15 5M7 5h8v8"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
  {name === "check" && (
    <path
      d="m3.5 10.5 4 4 9-9"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
  {name === "close" && (
    <path
      d="m5 5 10 10M15 5 5 15"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  )}
  {name === "copy" && (
    <>
      <rect
        x="7"
        y="7"
        width="9"
        height="9"
        rx="1.5"
        stroke="currentColor"
        stroke-width="1.4"
      />
      <path
        d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-6A1.5 1.5 0 0 0 4 5.5v6A1.5 1.5 0 0 0 5.5 13H7"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </>
  )}
  {name === "github" && (
    <path
      d="M10 1.4a8.6 8.6 0 0 0-2.72 16.76c.43.08.59-.18.59-.41v-1.55c-2.39.52-2.9-1.02-2.9-1.02-.39-1-.96-1.27-.96-1.27-.78-.53.06-.52.06-.52.86.06 1.31.88 1.31.88.77 1.31 2.01.93 2.5.71.08-.55.3-.93.55-1.14-1.91-.22-3.92-.96-3.92-4.25 0-.94.34-1.71.88-2.31-.09-.22-.38-1.09.08-2.28 0 0 .72-.23 2.36.88a8.2 8.2 0 0 1 4.3 0c1.64-1.11 2.36-.88 2.36-.88.46 1.19.17 2.06.08 2.28.55.6.88 1.37.88 2.31 0 3.3-2.01 4.03-3.93 4.24.31.27.58.8.58 1.61v2.39c0 .23.16.5.6.41A8.6 8.6 0 0 0 10 1.4Z"
      fill="currentColor"
    />
  )}
  {name === "menu" && (
    <path
      d="M3 6h14M3 10h14M3 14h14"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  )}
</svg>
