---
import Icon from "./Icon.astro";
import type { Copy } from "../i18n/en";

interface Props {
  copy: Copy["manifesto"];
}

const { copy } = Astro.props;
---

<section class="manifesto section--paper" id="why">
  <div class="container">
    <div class="manifesto__intro">
      <div data-reveal>
        <p class="kicker">{copy.kicker}</p>
        <h2>{copy.title}</h2>
      </div>

      <div class="manifesto__body" data-reveal style="--reveal-delay: 90ms">
        <p>{copy.body}</p>
        <p>{copy.body2}</p>
        <a class="text-link" href="#ladder">
          {copy.link}
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <dl class="stats" data-reveal style="--reveal-delay: 160ms">
      {
        copy.stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    padding-block: clamp(5rem, 9vw, 8.5rem);
    overflow: hidden;
  }

  .manifesto__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  h2 {
    max-width: 11ch;
    margin-top: 1.2rem;
    color: var(--paper-ink);
    font-size: clamp(3rem, 5.8vw, 5.9rem);
    line-height: 0.94;
  }

  .manifesto__body {
    display: grid;
    gap: 1.15rem;
    max-width: 38rem;
    padding-top: 2.6rem;
  }

  .manifesto__body p {
    color: var(--muted-paper);
    font-size: clamp(1rem, 1.35vw, 1.13rem);
    line-height: 1.72;
  }

  .manifesto__body p:first-child {
    color: var(--paper-ink);
    font-size: clamp(1.12rem, 1.7vw, 1.35rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .manifesto__body .text-link {
    width: fit-content;
    margin-top: 0.4rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-paper-strong);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.45rem;
    min-width: 0;
  }

  .stat + .stat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line-paper);
  }

  .stat dt {
    color: var(--muted-paper);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .stat dd {
    color: var(--forest);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4vw, 4.2rem);
    font-variation-settings: "opsz" 72, "SOFT" 30;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.8;
  }

  @media (max-width: 800px) {
    .manifesto__intro {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .manifesto__body {
      padding-top: 0;
    }

    .stats {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }

    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 520px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stat + .stat {
      padding-top: 1.25rem;
      padding-left: 0;
      border-top: 1px solid var(--line-paper);
      border-left: 0;
    }
  }
</style>
