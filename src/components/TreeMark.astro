---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["tree-mark", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M16 28V10"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <path
    d="m16 12-7-7M16 12l7-7M16 18l-6-6M16 18l6-6M16 24l-4-4M16 24l4-4"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <path
    d="M9 28h14"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  />
  <circle cx="16" cy="4.5" r="1.5" fill="currentColor" />
</svg>

<style>
  .tree-mark {
    width: 100%;
    height: 100%;
  }
</style>
